generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String      @id @default(cuid())
  name              String      @default("Freelancer")
  email             String?
  avatarUrl         String?
  defaultHourlyRate Float       @default(0)
  currency          String      @default("USD")
  currencySymbol    String      @default("$")
  dateFormat        String      @default("MM/dd/yyyy")
  timeFormat        String      @default("24h")
  weekStartDay      String      @default("monday")
  theme             String      @default("system")
  senderName        String?
  senderAddress     String?
  senderEmail       String?
  senderTaxId       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  timeEntries      TimeEntry[]
  projects         Project[]
  clients          Client[]
  tags             Tag[]
  descriptionRules DescriptionRule[]
  invoices         Invoice[]
}

model Client {
  id        String    @id @default(cuid())
  name      String
  email     String?
  notes     String?
  billingAddress String?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects  Project[]
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model Project {
  id             String      @id @default(cuid())
  name           String
  color          String      @default("#4F46E5")
  hourlyRate     Float?
  estimatedHours Float?
  status         String      @default("active")
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  timeEntries      TimeEntry[]
  descriptionRules DescriptionRule[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId])
  @@index([clientId])
}

model Tag {
  id          String          @id @default(cuid())
  name        String
  color       String          @default("#6B7280")
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeEntries TimeEntryTag[]
  createdAt   DateTime        @default(now())

  @@unique([name, userId])
  @@index([userId])
}

model TimeEntry {
  id          String          @id @default(cuid())
  description String          @default("")
  startTime   DateTime
  endTime     DateTime?
  duration    Int?
  billable    Boolean         @default(true)
  projectId   String?
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceId   String?
  invoice     Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  tags        TimeEntryTag[]
  invoiceLineItems InvoiceLineItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([startTime])
  @@index([userId, startTime])
  @@index([invoiceId])
}

model TimeEntryTag {
  timeEntryId String
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  tagId       String
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([timeEntryId, tagId])
  @@index([tagId])
}

model DescriptionRule {
  id          String   @id @default(cuid())
  description String
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([description, userId])
  @@index([userId])
}

model Invoice {
  id               String   @id @default(cuid())
  number           String
  status           String   @default("draft")
  issueDate        DateTime
  dueDate          DateTime
  currency         String
  currencySymbol   String
  subtotal         Float
  taxRate          Float    @default(0)
  taxAmount        Float    @default(0)
  discountPercent  Float    @default(0)
  discountAmount   Float    @default(0)
  total            Float
  notes            String?
  paymentTerms     String?
  senderName       String?
  senderAddress    String?
  senderEmail      String?
  senderTaxId      String?
  recipientName    String?
  recipientAddress String?
  recipientEmail   String?
  clientId         String?
  client           Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lineItems        InvoiceLineItem[]
  timeEntries      TimeEntry[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([number, userId])
  @@index([userId])
}

model InvoiceLineItem {
  id          String    @id @default(cuid())
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  rate        Float
  amount      Float
  sortOrder   Int       @default(0)
  timeEntryId String?
  timeEntry   TimeEntry? @relation(fields: [timeEntryId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([invoiceId])
}
